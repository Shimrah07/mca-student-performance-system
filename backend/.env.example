# =============================================================
# backend/.env.example
# Template for environment variables required by the backend.
#
# HOW TO USE:
#   1. Copy this file to a new file named ".env" (in the same folder):
#      In Windows PowerShell: Copy-Item .env.example .env
#   2. Fill in your actual values in the ".env" file.
#   3. Never commit ".env" to Git — it is listed in .gitignore.
#
# The application reads these variables automatically at startup
# using python-dotenv.
# =============================================================

# --- Database connection (MySQL) ---
# Replace with your local MySQL credentials:
DB_HOST=localhost
DB_PORT=3306
DB_NAME=mca_academic_system
DB_USER=mca_app
DB_PASSWORD=your_mysql_password

# Optional: You can provide a full DATABASE_URL directly instead.
# If set, DATABASE_URL overrides DB_HOST, DB_PORT, DB_NAME, DB_USER, DB_PASSWORD.
# Format: mysql+pymysql://<user>:<password>@<host>:<port>/<dbname>
# DATABASE_URL=mysql+pymysql://mca_app:your_mysql_password@localhost:3306/mca_academic_system

# --- Application settings ---
# Set to "development" locally, "production" when deployed
APP_ENV=development

# --- API / CORS settings ---
# Origins allowed to call the API (React Vite dev server by default)
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:5174,http://127.0.0.1:5174
