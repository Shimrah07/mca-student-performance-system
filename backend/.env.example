# =============================================================
# backend/.env.example
# Template for environment variables required by the backend.
#
# HOW TO USE:
#   1. Copy this file to a new file named ".env" (in the same folder).
#   2. Fill in your actual values in the ".env" file.
#   3. Never commit ".env" to Git — it is listed in .gitignore.
#
# The application reads these variables automatically at startup
# using python-dotenv.
# =============================================================

# --- Database connection ---
# Replace with your MySQL server details
DB_HOST=localhost
DB_PORT=3306
DB_NAME=student_performance_db
DB_USER=your_mysql_username
DB_PASSWORD=your_mysql_password

# --- Application settings ---
# Set to "development" locally, "production" when deployed
APP_ENV=development

# --- API settings ---
# Origins that are allowed to call the API (React dev server by default)
CORS_ORIGINS=http://localhost:5173
